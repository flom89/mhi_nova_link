    "step": {
      "user": {
        "title": "CompTrol Nova-Gateway verbinden",
        "description": "Gib die IP-Adresse oder den Hostnamen sowie die Zugangsdaten für dein NOVA_RC CompTrol Nova-Gateway ein.",
        "data": {
          "host": "IP-Adresse / Hostname",
          "username": "Benutzername",
          "password": "Passwort",
          "ssl_fingerprint": "SSL-Fingerprint (SHA256, optional)"
        }
      },
      "analytics": {
        "title": "Anonyme Nutzungsstatistiken",
        "description": "Hilf dabei, MHI Nova Link zu verbessern, indem du anonyme Nutzungsdaten teilst. Es werden ausschließlich die Integrationsversion, die Home-Assistant-Version und eine zufällig generierte anonyme ID übermittelt. Persönliche Daten oder Geräteinformationen werden niemals erfasst.",

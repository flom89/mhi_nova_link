{
  "config": {
    "step": {
      "user": {
        "title": "Connect CompTrol Nova gateway",
        "description": "Enter the IP address or hostname and the credentials for your NOVA_RC CompTrol Nova gateway. If no SSL fingerprint is provided and the gateway uses a self-signed certificate, the fingerprint will be automatically discovered on first connection. Verify the fingerprint in the integration options after setup.",
        "data": {
          "host": "IP address / hostname",
          "username": "Username",
          "password": "Password",
          "ssl_fingerprint": "SSL fingerprint (SHA256, optional)"
        }
      },
      "analytics": {
        "title": "Anonymous usage statistics",
        "description": "Help improve MHI Nova Link by sharing anonymous usage data. Only the integration version, Home Assistant version, and a randomly generated anonymous ID are sent. No personal data or device information is ever collected.",
        "data": {
          "analytics_opt_in": "Share anonymous usage statistics"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate gateway account",
        "description": "Update the gateway credentials used by this integration.",
        "data": {
          "username": "Username",
          "password": "Password",
          "ssl_fingerprint": "SSL fingerprint (SHA256, optional)"
        }
      },
      "init": {
        "description": "Adjust how often the gateway is polled for updates.",
        "data": {
          "poll_interval": "ZoneQueries Polling Interval",
          "time_series_poll_interval": "Timeseries Polling Interval"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the gateway. Check the IP address.",
      "invalid_auth": "Invalid username or password.",
      "invalid_ssl_fingerprint": "TLS certificate validation failed. Verify the configured fingerprint.",
      "invalid_ssl_fingerprint_format": "The SSL fingerprint format is invalid.",
      "unknown": "An unexpected error occurred."
    },
    "abort": {
      "already_configured": "This gateway is already configured in Home Assistant.",
      "reauth_successful": "Reauthentication was successful.",
      "reauth_unsuccessful": "Reauthentication failed."
    }
  },
  "options": {
    "step": {
      "init": {
        "description": "Adjust how often the gateway is polled for updates.",
        "data": {
          "poll_interval": "ZoneQueries Polling Interval",
          "time_series_poll_interval": "Timeseries Polling Interval",
          "ssl_fingerprint": "SSL fingerprint (SHA256, optional)",
          "username": "Username",
          "password": "Password",
          "analytics_opt_in": "Share anonymous usage statistics"
        }
      }
    }
  },
